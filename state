# ==================================================
# START
# ==================================================

@bot.on(events.NewMessage(pattern="/start"))
async def start(event):

    user = event.sender
    data = get_user(user.id)

    if not data["registered"]:

        await event.respond(
            "Добро пожаловать в UDD team!\nДля начала подай заявку.",
            buttons=kb_apply()
        )

    else:

        await event.respond(
            "Добро пожаловать!",
            buttons=kb_main()
        )


