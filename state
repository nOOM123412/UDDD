def start(message):
    user_id = message.from_user.id

    if is_new_user(user_id):

        users[user_id] = {
            "source": "",
            "experience": "",
            "time": "",
            "mode": "От 11"
        }

        profiles[user_id] = {
            "cash": 0,
            "profits": 0,
            "locks": 0
        }

        markup = types.InlineKeyboardMarkup()
        btn = types.InlineKeyboardButton(
            "Подать заявку",
            callback_data="apply"
        )
        markup.add(btn)

        bot.send_message(
            message.chat.id,
            "Добро пожаловать в UDD team!\nДля начала подай заявку.",
            reply_markup=markup
        )

    else:
        send_main_menu(message.chat.id)


