# --- База данных на JSON ---
def load_db():
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}


def save_db(data):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)


def register_user(user_id: int):
    db = load_db()
    uid_str = str(user_id)
    if uid_str not in db:
        db[uid_str] = {
            "reg_date": datetime.now().strftime("%Y-%m-%d"),
            "mode": "от iPhone 13",
            "payment_method": "CryptoBot"
        }
        save_db(db)


def get_days_in_team(user_id: int) -> int:
    db = load_db()
    uid_str = str(user_id)
    if uid_str in db:
        reg_date_str = db[uid_str]["reg_date"]
        reg_date = datetime.strptime(reg_date_str, "%Y-%m-%d")
        delta = datetime.now() - reg_date
        return max(0, delta.days)
    return 0


def get_user_mode(user_id: int) -> str:
    db = load_db()
    uid_str = str(user_id)
    if uid_str in db and "mode" in db[uid_str]:
        return db[uid_str]["mode"]
    return "от iPhone 13"


def update_user_mode(user_id: int, new_mode: str):
    db = load_db()
    uid_str = str(user_id)
    if uid_str in db:
        db[uid_str]["mode"] = new_mode
        save_db(db)


def get_user_payment_method(user_id: int) -> str:
    db = load_db()
    uid_str = str(user_id)
    if uid_str in db and "payment_method" in db[uid_str]:
        return db[uid_str]["payment_method"]
    return "CryptoBot"


def update_user_payment_method(user_id: int, new_method: str):
    db = load_db()
    uid_str = str(user_id)
    if uid_str in db:
        db[uid_str]["payment_method"] = new_method
        save_db(db)


