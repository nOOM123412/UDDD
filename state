# =========================================================
# TELETHON START
# =========================================================

def start_userbot():

    loop = asyncio.new_event_loop()

    asyncio.set_event_loop(loop)

    userbot.start()

    print("USERBOT STARTED")

    userbot.run_until_disconnected()

# =========================================================
# MAIN
# =========================================================

if __name__ == "__main__":

    threading.Thread(
        target=start_userbot,
        daemon=True
    ).start()

    print("BOT STARTED")

    app = Application.builder().token(
        BOT_TOKEN
    ).build()

    app.add_handler(
        CommandHandler(
            "start",
            start
        )
    )

    app.add_handler(
        CallbackQueryHandler(
            callbacks
        )
    )

    app.run_polling()
