# =========================
# Удаление прошлого сообщения
# =========================

async def delete_old(query):
    try:
        await query.message.delete()
    except:
        pass


# =========================
# /start
# =========================

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    data = get_user(user.id)

    if not data["registered"]:
        await update.message.reply_text(
            "Добро пожаловать в UDD team!\nДля начала подай заявку.",
            reply_markup=start_keyboard()
        )
    else:
        await update.message.reply_text(
            "Добро пожаловать!",
            reply_markup=main_menu_keyboard()
        )


# =========================
# Callback
# =========================

async def callbacks(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    user_id = str(query.from_user.id)
    data = get_user(user_id)

    # =====================
    # Заявка
    # =====================

    if query.data == "apply":
        await delete_old(query)

        text = (
            "UDD - Порядок и усилия.\n\n"
            "Мы создали комфортную среду для работы и общения. "
            "Чтобы еe сохранить - соблюдайте этические нормы общества."
        )

        await query.message.chat.send_message(
            text,
            reply_markup=next_keyboard()
        )

    elif query.data == "next_rules":
        await delete_old(query)

        await query.message.chat.send_message(
            "Откуда вы о нас узнали?",
            reply_markup=source_keyboard()
        )

    elif query.data.startswith("source_"):
        data["source"] = query.data.replace("source_", "")
        save_data(users)

        await delete_old(query)

        await query.message.chat.send_message(
            "Есть ли у вас опыт? Если - да, то какой?",
            reply_markup=experience_keyboard()
        )

    elif query.data.startswith("exp_"):
        data["experience"] = query.data.replace("exp_", "")
        save_data(users)

        await delete_old(query)

        await query.message.chat.send_message(
            "Какое время вы готовы уделять работе в день?",
            reply_markup=time_keyboard()
        )

    elif query.data.startswith("time_"):
        data["time"] = query.data.replace("time_", "")
        save_data(users)

        await delete_old(query)

        text = (
            "Ваша заявка:\n\n"
