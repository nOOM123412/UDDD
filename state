# =========================
# Запуск
# =========================

def main():
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(callbacks))

    print("Бот запущен!")

    app.run_polling()


if __name__ == "__main__":
    main()
