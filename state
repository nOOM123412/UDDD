@dp.message(PaymentStates.waiting_for_address, F.text)
async def process_received_address(message: types.Message, state: FSMContext):
    user_data = await state.get_data()
    menu_msg_id = user_data.get("menu_msg_id")
    chosen_network = user_data.get("chosen_network")
    
    update_user_payment_method(message.from_user.id, chosen_network)
    
    info_msg = await message.answer(
        text="Ваш адрес принят! Дальнейшие выплаты будут происходить на него."
    )
    
    await state.clear()
    await asyncio.sleep(2)
    
    try:
        await info_msg.delete()
    except Exception as e:
        logging.error(f"Не удалось удалить сообщение: {e}")
        
    try:
        await message.delete()
    except Exception as e:
        logging.error(f"Не удалось удалить сообщение пользователя: {e}")

    current_method = get_user_payment_method(message.from_user.id)
    payments_text = (
        "💳 Настройка выплат:\n\n"
        f"• Текущий метод выплат: {current_method}\n\n"
        "— Выберите метод выплаты:"
    )
    
    try:
        if os.path.exists(PHOTO_NAS):
            media = InputMediaPhoto(media=FSInputFile(PHOTO_NAS), caption=payments_text)
            await bot.edit_message_media(
                chat_id=message.chat.id,
                message_id=menu_msg_id,
                media=media,
                reply_markup=get_payments_keyboard()
            )
        else:
            await bot.edit_message_text(
                chat_id=message.chat.id,
                message_id=menu_msg_id,
                text=payments_text,
                reply_markup=get_payments_keyboard()
            )
    except Exception as e:
        logging.warning(f"Не удалось отредактировать меню выплат: {e}. Отправляем новое.")
        if os.path.exists(PHOTO_NAS):
            await message.answer_photo(photo=FSInputFile(PHOTO_NAS), caption=payments_text, reply_markup=get_payments_keyboard())
        else:
            await message.answer(text=payments_text, reply_markup=get_payments_keyboard())


