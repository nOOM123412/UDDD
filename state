# --- Вспомогательная функция для плавного редактирования фото и текста ---
async def edit_msg_with_photo(callback: types.CallbackQuery, text: str, photo_path: str, reply_markup):
    """Обновляет картинку и текст в одном сообщении без его удаления"""
    if os.path.exists(photo_path):
        media = InputMediaPhoto(media=FSInputFile(photo_path), caption=text)
        await callback.message.edit_media(media=media, reply_markup=reply_markup)
    else:
        logging.warning(f"Файл {photo_path} не найден! Отправлен только текст.")
        try:
            await callback.message.edit_text(text=text, reply_markup=reply_markup)
        except Exception:
            await callback.message.answer_photo(photo=FSInputFile(photo_path) if os.path.exists(photo_path) else None, caption=text, reply_markup=reply_markup)


