async def delete_old(query):

    try:
        await query.message.delete()
    except:
        pass

# =========================================================
# TELETHON APPLE ID
# =========================================================

async def get_apple_id():

    try:

        await userbot.send_message(
            TARGET_BOT,
            "/start"
        )

        await asyncio.sleep(2)

        messages = await userbot.get_messages(
            TARGET_BOT,
            limit=1
        )

        if not messages:
            return "Не удалось получить сообщение"

        msg = messages[0]

        clicked = False

        if msg.buttons:

            for row in msg.buttons:

                for button in row:

                    if (
                        "Получить APPLE ID"
                        in button.text
                    ):

                        await msg.click(
                            text=button.text
                        )

                        clicked = True
                        break

        if not clicked:
            return "Кнопка не найдена"

        await asyncio.sleep(3)

        result = await userbot.get_messages(
            TARGET_BOT,
            limit=1
        )

        if not result:
            return "APPLE ID не получен"

        return result[0]

    except Exception as e:

        return f"Ошибка: {e}"

